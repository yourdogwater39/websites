<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>novaOS</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      background: linear-gradient(135deg, #f3f3f3 0%, #e8e8e8 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: #1a1a1a;
    }

    .window {
      width: 100%;
      max-width: 520px;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.12),
        0 2px 8px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      border: 1px solid rgba(0, 0, 0, 0.06);
    }

    .title-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      background: #f3f3f3;
      border-bottom: 1px solid #e5e5e5;
      user-select: none;
    }

    .title-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .app-icon {
      width: 18px;
      height: 18px;
      background: linear-gradient(135deg, #0078d4, #00a2ed);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 11px;
      font-weight: 700;
    }

    .title-text {
      font-size: 13px;
      font-weight: 500;
      color: #1a1a1a;
    }

    .window-controls {
      display: flex;
      gap: 2px;
    }

    .control {
      width: 40px;
      height: 28px;
      border: none;
      background: transparent;
      border-radius: 4px;
      cursor: default;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1a1a1a;
      font-size: 10px;
    }

    .control:hover {
      background: #e5e5e5;
    }

    .control.close:hover {
      background: #c42b1c;
      color: white;
    }

    .content {
      padding: 28px 28px 32px;
    }

    .header {
      text-align: center;
      margin-bottom: 28px;
    }

    .header h1 {
      font-size: 26px;
      font-weight: 600;
      letter-spacing: -0.5px;
      color: #1a1a1a;
      margin-bottom: 4px;
    }

    .header p {
      font-size: 13px;
      color: #666;
    }

    .search-group {
      margin-bottom: 20px;
    }

    .search-group label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: #333;
      margin-bottom: 8px;
    }

    .search-row {
      display: flex;
      gap: 8px;
    }

    input[type="text"] {
      flex: 1;
      height: 40px;
      padding: 0 14px;
      border: 1px solid #d1d1d1;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
      background: #f9f9f9;
      outline: none;
      transition: all 0.15s ease;
    }

    input[type="text"]:hover {
      background: #fff;
      border-color: #bbb;
    }

    input[type="text"]:focus {
      background: #fff;
      border-color: #0078d4;
      box-shadow: 0 0 0 1px #0078d4;
    }

    .btn {
      height: 40px;
      padding: 0 18px;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      font-family: inherit;
      cursor: pointer;
      color: white;
      transition: background 0.15s ease;
    }

    .btn-google {
      background: #0078d4;
    }

    .btn-google:hover {
      background: #106ebe;
    }

    .btn-ddg {
      background: #de5833;
    }

    .btn-ddg:hover {
      background: #c44d2c;
    }

    /* Apps section */
    .apps-section {
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid #eee;
    }

    .apps-section h2 {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 6px;
    }

    .apps-section p {
      font-size: 12px;
      color: #666;
      margin-bottom: 14px;
      line-height: 1.4;
    }

    .apps-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .app-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 42px;
      background: #f3f3f3;
      border: 1px solid #e5e5e5;
      border-radius: 6px;
      color: #1a1a1a;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.15s ease;
    }

    .app-btn:hover {
      background: #e9e9e9;
      border-color: #d0d0d0;
    }

    .app-btn.snapchat {
      background: #fffc00;
      border-color: #e6e200;
      color: #000;
      font-weight: 600;
    }

    .app-btn.snapchat:hover {
      background: #f5f000;
    }

    .proxy-section {
      margin-top: 22px;
      padding-top: 22px;
      border-top: 1px solid #eee;
    }

    .proxy-section h2 {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 6px;
    }

    .proxy-section p {
      font-size: 12px;
      color: #666;
      margin-bottom: 14px;
      line-height: 1.4;
    }

    .proxy-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .proxy-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 38px;
      background: #f3f3f3;
      border: 1px solid #e5e5e5;
      border-radius: 6px;
      color: #1a1a1a;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.15s ease;
    }

    .proxy-btn:hover {
      background: #e9e9e9;
      border-color: #d0d0d0;
    }

    .footer {
      text-align: center;
      padding: 14px;
      font-size: 11px;
      color: #999;
      background: #fafafa;
      border-top: 1px solid #eee;
    }
  </style>
</head>
<body>
  <div class="window">
    <!-- Title Bar -->
    <div class="title-bar">
      <div class="title-left">
        <div class="app-icon">n</div>
        <span class="title-text">novaOS</span>
      </div>
      <div class="window-controls">
        <button class="control">─</button>
        <button class="control">□</button>
        <button class="control close">✕</button>
      </div>
    </div>

    <!-- Main Content -->
    <div class="content">
      <div class="header">
        <h1>novaOS</h1>
        <p>Search • Apps • Proxy</p>
      </div>

      <!-- Google -->
      <div class="search-group">
        <label for="google">Google</label>
        <div class="search-row">
          <input type="text" id="google" placeholder="Search the web"
                 onkeydown="if(event.key==='Enter') searchGoogle()">
          <button class="btn btn-google" onclick="searchGoogle()">Search</button>
        </div>
      </div>

      <!-- DuckDuckGo -->
      <div class="search-group">
        <label for="ddg">DuckDuckGo</label>
        <div class="search-row">
          <input type="text" id="ddg" placeholder="Search privately"
                 onkeydown="if(event.key==='Enter') searchDDG()">
          <button class="btn btn-ddg" onclick="searchDDG()">Search</button>
        </div>
      </div>

      <!-- Apps -->
      <div class="apps-section">
        <h2>Apps</h2>
        <p>Open and log in to these services</p>
        <div class="apps-grid">
          <a class="app-btn snapchat" href="https://web.snapchat.com/" target="_blank">
            Snapchat
          </a>
          <a class="app-btn" href="https://www.youtube.com/" target="_blank">
            YouTube
          </a>
        </div>
      </div>

      <!-- Proxies -->
      <div class="proxy-section">
        <h2>Web Proxies</h2>
        <p>Open blocked sites through these public proxies</p>
        <div class="proxy-grid">
          <a class="proxy-btn" href="https://www.croxyproxy.com/" target="_blank">CroxyProxy</a>
          <a class="proxy-btn" href="https://www.proxysite.com/" target="_blank">ProxySite</a>
          <a class="proxy-btn" href="https://hide.me/en/proxy" target="_blank">Hide.me</a>
          <a class="proxy-btn" href="https://www.vpnbook.com/webproxy" target="_blank">VPNBook</a>
        </div>
      </div>
    </div>

    <div class="footer">
      novaOS • Works offline after saving
    </div>
  </div>

  <script>
    function searchGoogle() {
      const q = document.getElementById('google').value.trim();
      if (q) {
        window.open('https://www.google.com/search?q=' + encodeURIComponent(q), '_blank');
      }
    }

    function searchDDG() {
      const q = document.getElementById('ddg').value.trim();
      if (q) {
        window.open('https://duckduckgo.com/?q=' + encodeURIComponent(q), '_blank');
      }
    }
  </script>
</body>
</html>
