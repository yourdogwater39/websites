
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOVA OS</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    height: 100vh;
    overflow: hidden;
    font-family: Arial, sans-serif;
    color: white;
    background:
      radial-gradient(circle at 20% 20%, #4668c9, transparent 40%),
      radial-gradient(circle at 80% 80%, #9b55c7, transparent 40%),
      linear-gradient(135deg, #11172d, #202c50);
}

.desktop {
    height: 100vh;
    padding: 25px;
    position: relative;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff20;
    backdrop-filter: blur(20px);
    padding: 12px 20px;
    border-radius: 18px;
    border: 1px solid #ffffff25;
}

.logo {
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 2px;
}

.clock {
    color: #e0eaff;
}

.apps {
    display: grid;
    grid-template-columns: repeat(2, 90px);
    gap: 25px;
    margin-top: 45px;
}

.app {
    text-align: center;
    cursor: pointer;
    padding: 10px;
    border-radius: 15px;
}

.app:hover {
    background: #ffffff25;
}

.app-icon {
    font-size: 38px;
    margin-bottom: 8px;
}

.app-name {
    font-size: 13px;
}

.window {
    display: none;
    position: absolute;
    top: 17%;
    left: 50%;
    transform: translateX(-50%);
    width: min(650px, 90%);
    height: 430px;
    background: #17213bea;
    backdrop-filter: blur(25px);
    border: 1px solid #ffffff35;
    border-radius: 20px;
    box-shadow: 0 20px 60px #0008;
    overflow: hidden;
}

.window-header {
    height: 48px;
    background: #ffffff15;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 15px;
}

.close {
    cursor: pointer;
    background: #ff5d70;
    border: none;
    color: white;
    border-radius: 50%;
    width: 22px;
    height: 22px;
}

.browser-content {
    padding: 20px;
    text-align: center;
}

.browser-content input {
    width: 70%;
    padding: 13px;
    border: none;
    outline: none;
    border-radius: 20px;
    font-size: 15px;
}

.browser-content button {
    padding: 13px 17px;
    border: none;
    border-radius: 20px;
    background: #568cff;
    color: white;
    cursor: pointer;
}

.engine {
    margin-top: 15px;
    padding: 10px;
    border-radius: 15px;
}

.dock {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 18px;
    padding: 14px 25px;
    background: #ffffff25;
    backdrop-filter: blur(25px);
    border: 1px solid #ffffff35;
    border-radius: 25px;
}

.dock span {
    font-size: 27px;
    cursor: pointer;
    transition: 0.2s;
}

.dock span:hover {
    transform: scale(1.3);
}

.welcome {
    position: absolute;
    right: 35px;
    top: 35%;
    text-align: right;
}

.welcome h1 {
    font-size: 40px;
    margin-bottom: 5px;
}

.welcome p {
    color: #c4d2f4;
}

@media(max-width: 600px) {
    .welcome {
        display: none;
    }

    .window {
        top: 15%;
        height: 400px;
    }
}
</style>
</head>

<body>

<div class="desktop">

    <div class="topbar">
        <div class="logo">✦ NOVA OS</div>
        <div class="clock" id="clock"></div>
    </div>

    <div class="apps">

        <div class="app" onclick="openWindow('browser')">
            <div class="app-icon">🌐</div>
            <div class="app-name">Browser</div>
        </div>

        <div class="app" onclick="window.open('https://www.youtube.com','_blank')">
            <div class="app-icon">▶️</div>
            <div class="app-name">YouTube</div>
        </div>

        <div class="app" onclick="window.open('https://www.google.com','_blank')">
            <div class="app-icon">🔍</div>
            <div class="app-name">Google</div>
        </div>

        <div class="app" onclick="openWindow('about')">
            <div class="app-icon">⚙️</div>
            <div class="app-name">Settings</div>
        </div>

    </div>

    <div class="welcome">
        <h1>Welcome back.</h1>
        <p>Your digital world starts here.</p>
    </div>

    <!-- Browser Window -->
    <div class="window" id="browser">
        <div class="window-header">
            <span>🌐 NOVA Browser</span>
            <button class="close" onclick="closeWindow('browser')">×</button>
        </div>

        <div class="browser-content">
            <h2>What are you looking for?</h2>

            <form onsubmit="search(event)">
                <input id="query" placeholder="Search the web..." required>
                <button type="submit">Go</button>
            </form>

            <br>

            <select class="engine" id="engine">
                <option value="https://duckduckgo.com/?q=">
                    DuckDuckGo
                </option>
                <option value="https://www.google.com/search?q=">
                    Google
                </option>
                <option value="https://www.bing.com/search?q=">
                    Bing
                </option>
            </select>
        </div>
    </div>

    <!-- Settings Window -->
    <div class="window" id="about">
        <div class="window-header">
            <span>⚙️ Settings</span>
            <button class="close" onclick="closeWindow('about')">×</button>
        </div>
        <div class="browser-content">
            <h2>NOVA OS</h2>
            <p>Version 1.0</p>
            <p>A lightweight web desktop made for Chromebooks.</p>
            <p>Theme: Midnight Purple</p>
        </div>
    </div>

    <!-- Bottom Dock -->
    <div class="dock">
        <span onclick="openWindow('browser')">🌐</span>
        <span onclick="window.open('https://www.youtube.com','_blank')">▶️</span>
        <span onclick="window.open('https://www.google.com','_blank')">🔍</span>
        <span onclick="openWindow('about')">⚙️</span>
    </div>

</div>

<script>
function openWindow(id) {
    document.getElementById(id).style.display = "block";
}

function closeWindow(id) {
    document.getElementById(id).style.display = "none";
}

function search(event) {
    event.preventDefault();

    const query = document.getElementById("query").value.trim();
    const engine = document.getElementById("engine").value;

    if (query) {
        window.open(engine + encodeURIComponent(query), "_blank");
    }
}

function updateClock() {
    document.getElementById("clock").textContent =
        new Date().toLocaleTimeString([], {
            hour: '2-digit',
            minute: '2-digit'
        });
}

updateClock();
setInterval(updateClock, 1000);
</script>

</body>
</html>
